# Локальная БД (docker compose) — URL задаётся в docker-compose.yml автоматически.
# Для разработки без Docker:
DATABASE_URL=postgresql://educa:YOUR_PASSWORD@localhost:5432/educa
DATABASE_SSL=false

# Облачная БД (если когда-нибудь понадобится снова):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres
# DATABASE_SSL=true

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key

# Server
PORT=5000
NODE_ENV=development

# Telegram
# BOT_TOKEN=
# WEB_APP_URL=https://ct-kubik.by
